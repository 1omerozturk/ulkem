{
  "slug": "ulkem",
  "version": "1.1.0",
  "orientation": "portrait",
  "scheme": "ulkem",
  "userInterfaceStyle": "automatic",
  "newArchEnabled": true,
  "ios": {
    "supportsTablet": true
  },
  "android": {
    "package": "com.omerozturk.ulkem",
    "edgeToEdgeEnabled": true
  },
  "web": {
    "bundler": "metro",
    "output": "static"
  },
  "plugins": [
    "expo-router",
    [
      "expo-splash-screen",
      {
        "imageWidth": 220,
        "resizeMode": "contain"
      }
    ],
    [
      "expo-sqlite",
      {
        "enableFTS": true,
        "useSQLCipher": true,
        "android": {
          "enableFTS": false,
          "useSQLCipher": false
        },
        "ios": {
          "customBuildFlags": [
            "-DSQLITE_ENABLE_DBSTAT_VTAB=1 -DSQLITE_ENABLE_SNAPSHOT=1"
          ]
        }
      }
    ],
    "expo-font",
    "expo-image",
    "expo-secure-store",
    "expo-status-bar",
    "expo-web-browser"
  ],
  "experiments": {
    "typedRoutes": true
  },
  "extra": {
    "router": {},
    "eas": {
      "projectId": "73fffe6f-21be-473c-baab-faa06e97e714"
    }
  },
  "owner": "1omerozturk",
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-3940256099942544~3347511713",
    "ios_app_id": "ca-app-pub-3940256099942544~1458002511",
    "delay_app_measurement_init": true
  }
}
