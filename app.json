{
  "expo": {
    "name": "Ülkem",
    "slug": "ulkem",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/ulkem-app-icon.png",
    "scheme": "ulkem",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
          "foregroundImage": "./assets/brand/ulkem-mark.png",
          "backgroundColor": "#F1F6F3"
      },
      "package": "com.omerozturk.ulkem",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand/ulkem-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/ulkem-mark.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F1F6F3"
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true,
          "android": {
            "enableFTS": false,
            "useSQLCipher": false
          },
          "ios": {
            "customBuildFlags": [
              "-DSQLITE_ENABLE_DBSTAT_VTAB=1 -DSQLITE_ENABLE_SNAPSHOT=1"
            ]
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "73fffe6f-21be-473c-baab-faa06e97e714"
      }
    },
    "owner": "1omerozturk"
  }
}
